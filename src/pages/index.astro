---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';

const experience = [
  { period: 'Aug 2025 — Sep 2026', company: 'NIUM', role: 'Software Development Engineer I', place: 'Mumbai', bullets: [
    'Built real-time Java/Spring Boot payment systems processing 5K+ daily transactions across 50+ banking partners with 99.99%+ uptime.',
    'Improved payment success rates by ~15% and reduced manual intervention by ~40% through automated validation.',
    'Built a Claude-powered MCP server for transaction-failure root-cause analysis using database logs and diagnostics, reducing investigation time by ~30%.',
    'Migrated SWIFT, IFSC, and bank-code reference data into a centralized graph-based system, reducing configuration complexity and improving partner onboarding.',
    'Added Redis caching to high-traffic lookups and operated AWS EKS microservices with automated scaling, CI/CD, and monitoring.'
  ]},
  { period: 'Apr 2025 — Aug 2025', company: 'Blacklight Studio', role: 'Associate Backend Developer', place: 'Noida', bullets: [
    'Built Java/Spring Boot backend services to improve platform scalability and modularity.',
    'Designed REST APIs and caching strategies that reduced average response time from ~200 ms to 50 ms (75%).',
    'Optimized database queries and implemented connection pooling to handle concurrent load with low latency.',
    'Collaborated with cross-functional teams to ship production features and maintain service reliability.'
  ]},
  { period: 'Oct 2024 — Feb 2025', company: 'Inorg (VivaOps)', role: 'Software Engineer', place: 'Pune', bullets: [
    'Built backend services and microservices with Java and Spring Boot for internal applications.',
    'Implemented Jenkins CI/CD pipelines, reducing manual deployment effort by ~70%.',
    'Managed AWS EC2, S3, RDS, and VPC with auto-scaling; used Terraform and Ansible to reduce deployment time from ~45 minutes to 5 minutes.',
    'Containerized applications with Docker and orchestrated them on Kubernetes.'
  ]}
];

const skillGroups = [
  { title: 'Languages', items: ['Java','SQL','C++','JavaScript'] },
  { title: 'Java & APIs', items: ['Spring Boot','Spring Framework','Spring Data JPA','Hibernate','Spring Cloud','Microservices','REST APIs'] },
  { title: 'Data & Messaging', items: ['MySQL','PostgreSQL','MongoDB','Redis','Amazon SQS','RabbitMQ','Event-Driven Architecture'] },
  { title: 'Cloud & DevOps', items: ['AWS','EKS','EC2','RDS','S3','VPC','Docker','Kubernetes','Jenkins','CI/CD','Terraform','Ansible'] },
  { title: 'Engineering', items: ['Multithreading','Concurrency','OOP','System Design','Agile/Scrum'] },
  { title: 'Tools & AI', items: ['Git','Maven','Gradle','IntelliJ IDEA','Postman','CloudWatch','Claude API','MCP','Prompt Engineering'] }
];

const projects = [
  {
    title: 'MCP Server — AI-Powered Root-Cause Analysis',
    type: 'FLAGSHIP CASE STUDY',
    company: 'NIUM',
    text: 'A Claude-powered MCP server that connected transaction context with database logs and diagnostics to help engineers investigate payment failures.',
    tags: ['Java','Spring Boot','MCP','Claude API','SQL'],
    problem: 'Investigating transaction failures required engineers to gather relevant transaction context, database records, and operational diagnostics.',
    approach: 'Built focused MCP tools to expose investigation context to Claude for structured root-cause analysis.',
    outcome: 'Reduced root-cause investigation time by approximately 30%. Internal company work; implementation details are summarized for confidentiality.',
    workflow: ['Payment failure context', 'Database logs and diagnostics', 'Claude-assisted analysis', 'RCA summary']
  },
  {
    title: 'Banking Reference Data Graph',
    type: 'DATA PLATFORM',
    company: 'NIUM',
    text: 'Migrated SWIFT, IFSC, and bank-code reference data from application code into a centralized graph-based system to simplify configuration and partner onboarding.',
    tags: ['Java','Reference Data','Microservices','Redis'],
    problem: 'SWIFT, IFSC, and bank-code reference data needed repeated maintenance across application configuration.',
    approach: 'Moved reference data into a centralized graph-based system.',
    outcome: 'Reduced configuration complexity and improved partner onboarding.'
  },
  {
    title: 'Word Lookup Dictionary',
    type: 'ALGORITHMIC PROJECT',
    company: 'Dictionary application',
    text: 'A dictionary application using Trie-based word lookup with O(m) lookup time, where m is the word length.',
    tags: ['Trie Search','Levenshtein Distance','Auto-suggestion','Fuzzy Matching'],
    source: 'https://github.com/AmanMalviya22/Online-Dictionary',
    sourceLabel: 'View source code',
    problem: 'Finding words and handling spelling variations requires fast exact lookup and useful suggestions.',
    approach: 'Implemented Trie-based lookup, auto-suggestion, and spell correction using Levenshtein distance with fuzzy matching.',
    outcome: 'Combines efficient exact search with spelling-aware suggestions and correction in one dictionary workflow.'
  }
];
---

<Layout>
  <header class="site-nav">
    <div class="container nav-inner">
      <a class="brand" href="#top"><span class="brand-mark">AM</span><span>Aman Malviya</span></a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="#about">About</a><a href="#experience">Experience</a><a href="#skills">Skills</a><a href="#projects">Projects</a><a href="#education">Education</a><a href="#contact">Contact</a>
      </nav>
      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav class="mobile-nav-menu" aria-label="Mobile navigation">
          <a href="#about">About</a><a href="#experience">Experience</a><a href="#skills">Skills</a><a href="#projects">Projects</a><a href="#education">Education</a><a href="#contact">Contact</a>
        </nav>
      </details>
      <a class="nav-button" href="https://www.linkedin.com/in/aman-malviya22/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
    </div>
  </header>

  <main id="top" tabindex="-1">
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status"></span> Bengaluru, India <span class="eyebrow-divider">·</span> Available for backend roles <span class="eyebrow-divider">·</span> Immediate joiner</p>
          <p class="kicker">BACKEND ENGINEER / JAVA · SPRING BOOT · AWS</p>
          <h1>I build reliable backend systems with <span>Java and Spring Boot.</span></h1>
          <p class="hero-text">Around 2 years of software development experience across payment services, cloud-native microservices, data platforms, and AI-assisted diagnostics.</p>
          <div class="actions"><a class="btn primary" href="#projects">View selected work <span aria-hidden="true">↘</span></a><a class="btn secondary" href="https://drive.google.com/file/d/1UAiN7kRxYpltmuhkUAtIGARZMRg4_MQC/view?usp=sharing" target="_blank" rel="noopener noreferrer">View resume <span aria-hidden="true">↗</span></a></div>
          <a class="hero-link" href="https://www.linkedin.com/in/aman-malviya22/" target="_blank" rel="noreferrer">LinkedIn profile <span aria-hidden="true">↗</span></a>
        </div>
        <aside class="hero-panel" aria-label="Backend engineering highlights">
          <p class="panel-label">BACKEND ENGINEERING</p>
          <h2>Built for real-world systems.</h2>
          <p class="panel-copy">Payment processing, distributed services, data access, and operational reliability.</p>
          <div class="stack-list"><span>Java</span><span>Spring Boot</span><span>Microservices</span><span>AWS</span><span>Redis</span><span>SQL</span><span>Docker</span><span>Kubernetes</span></div>
          <div class="panel-divider"></div>
          <div class="hero-metrics">
            <div><strong>5K+</strong><span>daily transactions</span></div>
            <div><strong>50+</strong><span>banking partners</span></div>
            <div><strong>99.99%+</strong><span>uptime</span></div>
          </div>
        </aside>
      </div>
    </section>

    <section class="impact-section" aria-label="Selected engineering impact">
      <div class="container impact-grid">
        <div class="impact-intro">
          <p class="label">SELECTED IMPACT</p>
          <p>Production improvements, not just features shipped.</p>
        </div>
        <article class="impact-stat">
          <strong>~15%</strong>
          <span>Higher payment success</span>
          <small>Automated validation</small>
        </article>
        <article class="impact-stat">
          <strong>~40%</strong>
          <span>Less manual intervention</span>
          <small>Automated validation</small>
        </article>
        <article class="impact-stat">
          <strong>~30%</strong>
          <span>Faster root-cause investigations</span>
          <small>Claude-powered MCP tooling</small>
        </article>
      </div>
    </section>

    <section id="about" class="section">
      <div class="container split">
        <div><p class="label">01 / ABOUT</p><h2>Practical engineering, built for production.</h2></div>
        <div class="about-copy"><p class="lead">I work on backend services where correctness, latency, and reliability matter. My experience spans fintech payment flows, reference data, AWS-based microservices, and AI-assisted root-cause analysis.</p>
          <p class="about-detail">I value simple APIs, clear service boundaries, useful observability, and code that is easy for another engineer to maintain.</p>
          <div class="about-tags"><span>Backend APIs</span><span>Distributed systems</span><span>Production reliability</span><span>AI-assisted tooling</span></div>
        </div>
      </div>
    </section>

    <section id="experience" class="section alt">
      <div class="container"><div class="wide-heading"><p class="label">02 / EXPERIENCE</p><h2>Experience in production environments.</h2><p>Backend development across fintech, data platforms, and infrastructure.</p></div>
        <div class="timeline">
          {experience.map((job) => <article class="timeline-item">
            <div class="rail"><span></span></div>
            <div>
              <div class="meta"><span>{job.period}</span><span>{job.place}</span></div>
              <h3>{job.role}</h3>
              <p class="company">{job.company}</p>
              <ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
            </div>
          </article>)}
        </div>
      </div>
    </section>

    <section id="skills" class="section">
      <div class="container">
        <div class="wide-heading"><p class="label">03 / SKILLS</p><h2>A focused backend stack.</h2><p>Core technologies I use to build, ship, and operate backend services.</p></div>
        <div class="skill-groups">
          {skillGroups.map((group) => <article class="skill-group">
            <h3>{group.title}</h3>
            <div class="skills-wrap">{group.items.map((skill) => <span class="skill">{skill}</span>)}</div>
          </article>)}
        </div>
      </div>
    </section>

    <section id="projects" class="section alt">
      <div class="container"><div class="wide-heading row-head"><div><p class="label">04 / PROJECTS</p><h2>Selected backend work.</h2></div><a class="text-link" href="https://github.com/AmanMalviya22" target="_blank" rel="noreferrer">Browse GitHub ↗</a></div>
        <div class="project-grid">
          {projects.map((project, index) => (
            <article class={'project '+(index===0?'project-featured':'')}>
              <div class="project-heading">
                <small>{project.type}</small>
                {!project.source && <span class="internal-badge">Internal · no public demo</span>}
              </div>
              <h3>{project.title}</h3>
              <p class="project-company">{project.company}</p>
              <p class="project-description">{project.text}</p>
              {project.workflow && <div class="workflow">
                <p class="workflow-label">HIGH-LEVEL WORKFLOW · CONFIDENTIALITY-SAFE OVERVIEW</p>
                <div class="workflow-steps" aria-label="Conceptual root-cause analysis workflow">
                  {project.workflow.map((step, stepIndex) => <div class="workflow-step"><span>{String(stepIndex + 1).padStart(2, '0')}</span><strong>{step}</strong></div>)}
                </div>
              </div>}
              <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
              {project.problem && <div class="project-story">
                <div><span>Problem</span><p>{project.problem}</p></div>
                <div><span>Approach</span><p>{project.approach}</p></div>
                <div><span>Outcome</span><p>{project.outcome}</p></div>
              </div>}
              <div class="project-links">
                {!project.source && <span class="project-note">Internal case study; details are summarized for confidentiality.</span>}
                {project.source && <a href={project.source} target="_blank" rel="noreferrer">{project.sourceLabel} <span aria-hidden="true">↗</span></a>}
                <a href="#contact">Discuss this work <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="education" class="section">
      <div class="container">
        <div class="wide-heading"><p class="label">05 / EDUCATION & RECOGNITION</p><h2>Education and competitive programming.</h2></div>
        <div class="credentials-grid">
          <article class="credential-card">
            <p class="credential-type">EDUCATION</p>
            <h3>B.Tech in Computer Science</h3>
            <p>Shri Mata Vaishno Devi University</p>
            <span>2020 – 2024</span>
          </article>
          <article class="credential-card">
            <p class="credential-type">ACHIEVEMENT</p>
            <h3>CodeChef · 4-star</h3>
            <p>1654 points · Global Rank 2 in the November Long 2022 contest, Division 3 (Rated).</p>
          </article>
        </div>
      </div>
    </section>

    <section id="contact" class="section contact">
      <div class="container contact-card"><div><p class="label">06 / CONTACT</p><h2>Let's build something useful.</h2><p>For backend engineering roles, technical conversations, or interesting engineering problems.</p><div class="contact-details"><a href="mailto:amanaman26802@gmail.com">amanaman26802@gmail.com</a><a href="tel:+919149736306">+91 91497 36306</a></div></div><div class="contact-actions"><a class="btn primary" href="https://www.linkedin.com/in/aman-malviya22/" target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a><a class="btn secondary" href="https://drive.google.com/file/d/1UAiN7kRxYpltmuhkUAtIGARZMRg4_MQC/view?usp=sharing" target="_blank" rel="noopener noreferrer">View resume <span aria-hidden="true">↗</span></a><a class="contact-github" href="https://drive.google.com/uc?export=download&amp;id=1UAiN7kRxYpltmuhkUAtIGARZMRg4_MQC" target="_blank" rel="noopener noreferrer">Download resume ↓</a><a class="contact-github" href="https://github.com/AmanMalviya22" target="_blank" rel="noopener noreferrer">GitHub profile ↗</a></div></div>
    </section>
  </main>

  <footer class="footer"><div class="container footer-inner"><span>© 2026 Aman Malviya</span><span>Backend Engineer · Java · Spring Boot</span><a href="#top">Back to top ↑</a></div></footer>
</Layout>
