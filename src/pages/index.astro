---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';

const experience = [
  { period: 'Aug 2025 — Sep 2026', company: 'NIUM', role: 'Software Development Engineer I', place: 'Mumbai, India', bullets: [
    'Engineered core payment microservices with Java 17, Spring Boot, and AWS EKS (Kubernetes), orchestrating 20K+ daily transactions across 50+ global banking partners while maintaining 99.99%+ availability.',
    'Automated payment-validation pre-checks and routing rules, boosting transaction success rates by 15% and reducing manual operational intervention by 40%.',
    'Engineered fault-tolerant messaging using Amazon SQS redrive policies (maxReceiveCount tuned from 5 to 1) and Dead Letter Queue (DLQ) isolation, eliminating 80% of unproductive retry cycles.',
    'Built a Claude-powered Model Context Protocol (MCP) server unifying Grafana logs, DB diagnostics, and Bitbucket context, reducing production root-cause investigation time by 30%.',
    'Migrated banking partner reference data into a centralized Amazon Neptune (graph database) backed by Redis caching, simplifying partner onboarding and accelerating high-traffic routing lookups.'
  ]}
];

const skillGroups = [
  { title: 'Languages & Core', items: ['Java (17, 11, 8)','SQL','JavaScript','Bash','RESTful APIs','Multithreading','Concurrency','OOP'] },
  { title: 'Backend & Frameworks', items: ['Spring Boot','Spring MVC','Spring Data JPA','Hibernate','Spring Cloud','Spring Security','Microservices'] },
  { title: 'Databases & Messaging', items: ['PostgreSQL','MySQL','Amazon Neptune','MongoDB','Redis','Apache Kafka','Amazon SQS','RabbitMQ'] },
  { title: 'Cloud & DevOps', items: ['AWS (EKS, EC2, RDS, S3, VPC, SQS, CloudWatch)','Docker','Kubernetes','Jenkins','CI/CD','Terraform','Linux'] },
  { title: 'Testing & Developer Tools', items: ['JUnit 5','Mockito','Git','Bitbucket','Maven','Gradle','Postman','Grafana','IntelliJ IDEA'] },
  { title: 'AI Engineering & Methods', items: ['Claude API','Model Context Protocol (MCP)','LLM Integration','Prompt Engineering','Agile/Scrum'] }
];

const projects = [
  {
    title: 'SlotMind – AI Appointment Engine', type: 'Backend · AI Integration · Event-Driven',
    company: 'Hackathon Project', tags: ['Java 17', 'Spring Boot 3', 'Kafka', 'Redis', 'PostgreSQL', 'LLM'],
    text: 'AI-Powered Event-Driven Appointment Re-Scheduling Engine managing complete appointment and slot lifecycles.',
    problem: 'Provider offline scenarios cause manual rescheduling overhead and risk race conditions during high traffic.',
    approach: 'Built a pluggable Strategy Pattern engine combining nearest-slot heuristics with LLM recommendations. Validated AI outputs against live Redis availability and used PostgreSQL pessimistic locking.',
    outcome: 'Automated schedule recovery, eliminated double-booking, and processed events asynchronously via Apache Kafka.',
    workflow: ['Provider Offline Event', 'Kafka Topic Ingestion', 'LLM Recommendation Engine', 'Redis Validation', 'PostgreSQL Lock & Update'],
    source: 'https://github.com/AmanMalviya22', sourceLabel: 'View Repository'
  }
];
---

<Layout>
  <header class="site-nav">
    <div class="container nav-inner">
      <a class="brand" href="#top"><span class="brand-mark">AM</span><span>Aman Malviya</span></a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="#about">About</a><a href="#experience">Experience</a><a href="#skills">Skills</a><a href="#projects">Projects</a><a href="#education">Education</a><a href="#contact">Contact</a>
      </nav>
      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav class="mobile-nav-menu" aria-label="Mobile navigation">
          <a href="#about">About</a><a href="#experience">Experience</a><a href="#skills">Skills</a><a href="#projects">Projects</a><a href="#education">Education</a><a href="#contact">Contact</a>
        </nav>
      </details>
      <a class="nav-button" href="https://www.linkedin.com/in/aman-malviya22/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
    </div>
  </header>

  <main id="top" tabindex="-1">
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status"></span> Mumbai (Open to Relocate) <span class="eyebrow-divider">·</span> Available for backend roles <span class="eyebrow-divider">·</span> Immediate joiner</p>
          <p class="kicker">SOFTWARE ENGINEER / JAVA · SPRING BOOT · KAFKA · AWS</p>
          <h1>I build reliable backend systems with <span>Java and Spring Boot.</span></h1>
          <p class="hero-text">Software Engineer with 2+ years of experience architecting high-scale FinTech payment systems and distributed microservices using Java 17, Spring Boot, Kafka, Redis, and AWS. Proven track record in low-latency REST APIs, database tuning, DLQ messaging resiliency, and AI diagnostics across 50+ banking partners.</p>
          <div class="actions"><a class="btn primary" href="#projects">View selected work <span aria-hidden="true">↘</span></a><a class="btn secondary" href="https://drive.google.com/file/d/151XovB5tNB0BQhn6p48VDWKtYE93CyPZ/view?usp=sharing" target="_blank" rel="noopener noreferrer">View resume <span aria-hidden="true">↗</span></a></div>
          <a class="hero-link" href="https://www.linkedin.com/in/aman-malviya22/" target="_blank" rel="noreferrer">LinkedIn profile <span aria-hidden="true">↗</span></a>
        </div>
        <aside class="hero-panel" aria-label="Backend engineering highlights">
          <p class="panel-label">BACKEND ENGINEERING</p>
          <h2>Built for real-world systems.</h2>
          <p class="panel-copy">Payment processing, distributed services, data access, and operational reliability.</p>
          <div class="stack-list"><span>Java</span><span>Spring Boot</span><span>Microservices</span><span>AWS</span><span>Redis</span><span>SQL</span><span>Docker</span><span>Kubernetes</span></div>
          <div class="panel-divider"></div>
          <div class="hero-metrics">
            <div><strong>20K+</strong><span>daily transactions</span></div>
            <div><strong>50+</strong><span>banking partners</span></div>
            <div><strong>99.99%+</strong><span>availability</span></div>
          </div>
        </aside>
      </div>
    </section>

        <section class="impact-section" aria-label="Selected engineering impact">
      <div class="container impact-grid">
        <div class="impact-intro">
          <p class="label">SELECTED IMPACT</p>
          <p>Production improvements, not just features shipped.</p>
        </div>
        <article class="impact-stat">
          <strong>15%</strong>
          <span>Higher payment success</span>
          <small>Automated validation</small>
        </article>
        <article class="impact-stat">
          <strong>80%</strong>
          <span>Fewer unproductive retries</span>
          <small>DLQ isolation & SQS tuning</small>
        </article>
        <article class="impact-stat">
          <strong>30%</strong>
          <span>Faster investigations</span>
          <small>Claude-powered MCP tooling</small>
        </article>
      </div>
    </section>

    <section id="about" class="section">
      <div class="container split">
        <div><p class="label">01 / ABOUT</p><h2>Practical engineering, built for production.</h2></div>
        <div class="about-copy"><p class="lead">I work on backend services where correctness, latency, and reliability matter. My experience spans fintech payment flows, reference data, AWS-based microservices, and AI-assisted root-cause analysis.</p>
          <p class="about-detail">I value simple APIs, clear service boundaries, useful observability, and code that is easy for another engineer to maintain.</p>
          <div class="about-tags"><span>Backend APIs</span><span>Distributed systems</span><span>Production reliability</span><span>AI-assisted tooling</span></div>
        </div>
      </div>
    </section>

    <section id="experience" class="section alt">
      <div class="container"><div class="wide-heading"><p class="label">02 / EXPERIENCE</p><h2>Experience in production environments.</h2><p>Backend development across fintech, data platforms, and infrastructure.</p></div>
        <div class="timeline">
          {experience.map((job) => <article class="timeline-item">
            <div class="rail"><span></span></div>
            <div>
              <div class="meta"><span>{job.period}</span><span>{job.place}</span></div>
              <h3>{job.role}</h3>
              <p class="company">{job.company}</p>
              <ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
            </div>
          </article>)}
        </div>
      </div>
    </section>

    <section id="skills" class="section">
      <div class="container">
        <div class="wide-heading"><p class="label">03 / SKILLS</p><h2>A focused backend stack.</h2><p>Core technologies I use to build, ship, and operate backend services.</p></div>
        <div class="skill-groups">
          {skillGroups.map((group) => <article class="skill-group">
            <h3>{group.title}</h3>
            <div class="skills-wrap">{group.items.map((skill) => <span class="skill">{skill}</span>)}</div>
          </article>)}
        </div>
      </div>
    </section>

    <section id="projects" class="section alt">
      <div class="container"><div class="wide-heading row-head"><div><p class="label">04 / PROJECTS</p><h2>Selected backend work.</h2></div><a class="text-link" href="https://github.com/AmanMalviya22" target="_blank" rel="noreferrer">Browse GitHub ↗</a></div>
        <div class="project-grid">
          {projects.map((project, index) => (
            <article class={'project '+(index===0?'project-featured':'')}>
              <div class="project-heading">
                <small>{project.type}</small>
                {!project.source && <span class="internal-badge">Internal · no public demo</span>}
              </div>
              <h3>{project.title}</h3>
              <p class="project-company">{project.company}</p>
              <p class="project-description">{project.text}</p>
              {project.workflow && <div class="workflow">
                <p class="workflow-label">HIGH-LEVEL WORKFLOW · CONFIDENTIALITY-SAFE OVERVIEW</p>
                <div class="workflow-steps" aria-label="Conceptual root-cause analysis workflow">
                  {project.workflow.map((step, stepIndex) => <div class="workflow-step"><span>{String(stepIndex + 1).padStart(2, '0')}</span><strong>{step}</strong></div>)}
                </div>
              </div>}
              <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
              {project.problem && <div class="project-story">
                <div><span>Problem</span><p>{project.problem}</p></div>
                <div><span>Approach</span><p>{project.approach}</p></div>
                <div><span>Outcome</span><p>{project.outcome}</p></div>
              </div>}
              <div class="project-links">
                {!project.source && <span class="project-note">Internal case study; details are summarized for confidentiality.</span>}
                {project.source && <a href={project.source} target="_blank" rel="noreferrer">{project.sourceLabel} <span aria-hidden="true">↗</span></a>}
                <a href="#contact">Discuss this work <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="education" class="section">
      <div class="container">
        <div class="wide-heading"><p class="label">05 / EDUCATION & RECOGNITION</p><h2>Education and competitive programming.</h2></div>
        <div class="credentials-grid">
          <article class="credential-card">
            <p class="credential-type">EDUCATION</p>
            <h3>B.Tech in Computer Science and Engineering</h3>
            <p>Shri Mata Vaishno Devi University</p>
            <span>2020 – 2024</span>
          </article>
          <article class="credential-card">
            <p class="credential-type">ACHIEVEMENT</p>
            <h3>CodeChef (4-Star, 1829)</h3>
            <p>Global Rank 2 in the November Long Contest (Division 3, Rated).</p>
          </article>
        </div>
      </div>
    </section>

    <section id="contact" class="section contact">
      <div class="container contact-card"><div><p class="label">06 / CONTACT</p><h2>Let's build something useful.</h2><p>For backend engineering roles, technical conversations, or interesting engineering problems.</p><div class="contact-details"><a href="mailto:amanaman26802@gmail.com">amanaman26802@gmail.com</a><a href="tel:+919149736306">+91 91497 36306</a></div></div><div class="contact-actions"><a class="btn primary" href="https://www.linkedin.com/in/aman-malviya22/" target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a><a class="btn secondary" href="https://drive.google.com/file/d/151XovB5tNB0BQhn6p48VDWKtYE93CyPZ/view?usp=sharing" target="_blank" rel="noopener noreferrer">View resume <span aria-hidden="true">↗</span></a><a class="contact-github" href="https://drive.google.com/uc?export=download&amp;id=151XovB5tNB0BQhn6p48VDWKtYE93CyPZ" target="_blank" rel="noopener noreferrer">Download resume ↓</a><a class="contact-github" href="https://github.com/AmanMalviya22" target="_blank" rel="noopener noreferrer">GitHub profile ↗</a></div></div>
    </section>
  </main>

  <footer class="footer"><div class="container footer-inner"><span>© 2026 Aman Malviya</span><span>Backend Engineer · Java · Spring Boot</span><a href="#top">Back to top ↑</a></div></footer>
</Layout>
