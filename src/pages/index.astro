---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';

const experience = [
  { period: 'Aug 2025 — Sep 2026', company: 'NIUM', role: 'Software Development Engineer I', place: 'Mumbai', bullets: [
    'Built Java/Spring Boot payment services handling 5K+ daily transactions across 50+ banking partners.',
    'Improved payment success rates by ~15% and reduced manual intervention by ~40% through automated validation.',
    'Built an MCP + Claude workflow for transaction-failure root-cause analysis and operational diagnostics.',
    'Used Redis caching, AWS EKS, CI/CD, monitoring, and automated scaling for production microservices.'
  ]},
  { period: 'Apr 2025 — Aug 2025', company: 'Blacklight Studio', role: 'Associate Backend Developer', place: 'Remote', bullets: [
    'Built and debugged backend features using Java, REST APIs, SQL, and object-oriented design.',
    'Worked across development and delivery workflows to ship maintainable application changes.'
  ]},
  { period: 'Oct 2024 — Feb 2025', company: 'Inorg / VivaOps', role: 'Associate DevOps Engineer', place: 'Remote', bullets: [
    'Worked with CI/CD, containers, cloud deployment concepts, and operational troubleshooting.',
    'Improved engineering workflows through automation and deployment support.'
  ]}
];

const skillGroups = [
  { title: 'Backend', items: ['Java','Spring Boot','Spring Data JPA','Hibernate','Microservices','REST APIs'] },
  { title: 'Data', items: ['SQL','MySQL','PostgreSQL','MongoDB','Redis'] },
  { title: 'Cloud & DevOps', items: ['AWS','EKS','Docker','Kubernetes','Jenkins','Terraform'] },
  { title: 'Messaging', items: ['SQS','RabbitMQ'] },
  { title: 'Engineering', items: ['Distributed Systems','System Design','Multithreading','Concurrency','Git'] },
  { title: 'AI Tooling', items: ['MCP','Claude'] }
];

const projects = [
  {
    title: 'MCP Server — AI-Powered RCA',
    type: 'Flagship · Internal',
    company: 'VM Media Private Limited',
    text: 'An internal MCP server that connected an AI assistant with transaction context, database information, and operational logs to help engineers investigate failures more efficiently.',
    tags: ['Java','Spring Boot','MCP','Claude','SQL'],
    detail: 'Transaction context → MCP tools → internal data/logs → structured diagnostic insights',
    architecture: ['Transaction context','MCP server','Database + logs','Claude → RCA insights'],
    problem: 'Production failures could require engineers to move between transaction data, database records, and operational logs during investigation.',
    approach: 'Built an MCP-based workflow with focused diagnostic tools and connected that context to Claude for structured analysis.',
    outcome: 'A repeatable AI-assisted investigation workflow that makes failure analysis faster to navigate and easier to reason about.'
  },
  {
    title: 'Reference Data Graph',
    type: 'Platform + Data',
    company: 'Backend engineering',
    text: 'Centralized SWIFT, IFSC, and banking-reference data with fast lookup paths and Redis caching for high-traffic services.',
    tags: ['Java','Redis','AWS','Caching'],
    detail: 'Reference data → centralized lookup → cache → low-latency access',
    architecture: ['Reference sources','Central data layer','Redis cache','Service lookup']
  }
];
---

<Layout>
  <header class="site-nav">
    <div class="container nav-inner">
      <a class="brand" href="#top"><span class="brand-mark">AM</span><span>Aman Malviya</span></a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="#about">About</a><a href="#experience">Experience</a><a href="#skills">Skills</a><a href="#projects">Projects</a><a href="#contact">Contact</a>
      </nav>
      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav class="mobile-nav-menu" aria-label="Mobile navigation">
          <a href="#about">About</a><a href="#experience">Experience</a><a href="#skills">Skills</a><a href="#projects">Projects</a><a href="#contact">Contact</a>
        </nav>
      </details>
      <a class="nav-button" href="https://www.linkedin.com/in/aman-malviya22/" target="_blank" rel="noreferrer">Connect ↗</a>
    </div>
  </header>

  <main id="top" tabindex="-1">
    <section class="hero">
      <div class="hero-grid"></div><div class="hero-glow glow-a"></div><div class="hero-glow glow-b"></div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status"></span> Available for backend roles <span class="eyebrow-divider">·</span> Immediate joiner</p>
          <p class="kicker">BACKEND ENGINEER / JAVA · SPRING BOOT · AWS</p>
          <h1>I build reliable backend systems with <span>Java and Spring Boot.</span></h1>
          <p class="hero-text">Around 2 years of software development experience across payment services, cloud-native microservices, data platforms, and AI-assisted diagnostics.</p>
          <div class="actions"><a class="btn primary" href="#projects">View selected work <span aria-hidden="true">↘</span></a><a class="btn secondary" href="https://www.linkedin.com/in/aman-malviya22/" target="_blank" rel="noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a></div>
        </div>
        <aside class="hero-panel" aria-label="Backend engineering highlights">
          <p class="panel-label">BACKEND ENGINEERING</p>
          <h2>Built for real-world systems.</h2>
          <p class="panel-copy">Payment processing, distributed services, data access, and operational reliability.</p>
          <div class="stack-list"><span>Java</span><span>Spring Boot</span><span>Microservices</span><span>AWS</span><span>Redis</span><span>SQL</span><span>Docker</span><span>Kubernetes</span></div>
          <div class="panel-divider"></div>
          <div class="hero-metrics">
            <div><strong>5K+</strong><span>daily transactions</span></div>
            <div><strong>50+</strong><span>banking partners</span></div>
            <div><strong>99.9%+</strong><span>uptime</span></div>
          </div>
        </aside>
      </div>
      <div class="container scroll-hint"><span>Scroll to explore</span><i></i></div>
    </section>

    <section id="about" class="section">
      <div class="container split">
        <div><p class="label">01 / ABOUT</p><h2>Practical engineering, built for production.</h2></div>
        <div class="about-copy"><p class="lead">I work on backend services where correctness, latency, and reliability matter. My experience spans fintech payment flows, reference data, AWS-based microservices, and AI-assisted root-cause analysis.</p>
          <p class="about-detail">I value simple APIs, clear service boundaries, useful observability, and code that is easy for another engineer to maintain.</p>
          <div class="about-tags"><span>Backend APIs</span><span>Distributed systems</span><span>Production reliability</span><span>AI-assisted tooling</span></div>
        </div>
      </div>
    </section>

    <section id="experience" class="section alt">
      <div class="container"><div class="wide-heading"><p class="label">02 / EXPERIENCE</p><h2>Experience in production environments.</h2><p>Backend development across fintech, data platforms, and infrastructure.</p></div>
        <div class="timeline">
          {experience.map((job) => <article class="timeline-item">
            <div class="rail"><span></span></div>
            <div>
              <div class="meta"><span>{job.period}</span><span>{job.place}</span></div>
              <h3>{job.role}</h3>
              <p class="company">{job.company}</p>
              <ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
            </div>
          </article>)}
        </div>
      </div>
    </section>

    <section id="skills" class="section">
      <div class="container">
        <div class="wide-heading"><p class="label">03 / SKILLS</p><h2>A focused backend stack.</h2><p>Core technologies I use to build, ship, and operate backend services.</p></div>
        <div class="skill-groups">
          {skillGroups.map((group) => <article class="skill-group">
            <h3>{group.title}</h3>
            <div class="skills-wrap">{group.items.map((skill) => <span class="skill">{skill}</span>)}</div>
          </article>)}
        </div>
      </div>
    </section>

    <section id="projects" class="section alt">
      <div class="container"><div class="wide-heading row-head"><div><p class="label">04 / PROJECTS</p><h2>Selected backend work.</h2></div><a class="text-link" href="https://github.com/AmanMalviya22" target="_blank" rel="noreferrer">Browse GitHub ↗</a></div>
        <div class="project-grid">
          {projects.map((project, index) => (
            <article class={'project '+(index===0?'project-featured':'')}>
              <span class="project-no">0{index + 1}</span>
              <small>{project.type}</small>
              <h3>{project.title}</h3>
              <p class="project-company">{project.company}</p>
              <p>{project.text}</p>
              <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
              {index===0 && <div class="internal-badge">Internal company project · no public demo</div>}
              {index===0 && <div class="project-story">
                <div><span>Problem</span><p>{project.problem}</p></div>
                <div><span>Approach</span><p>{project.approach}</p></div>
                <div><span>Outcome</span><p>{project.outcome}</p></div>
              </div>}
              <div class="project-links">
                {index===0
                  ? <span class="project-note">Architecture and implementation details are intentionally summarized.</span>
                  : <a href="#contact">Discuss the work ↗</a>}
                <details class="project-more">
                  <summary>View system shape +</summary>
                  <p>{project.detail}</p>
                  <div class="project-flow">
                    {project.architecture.map((step, stepIndex) => <span><b>0{stepIndex + 1}</b>{step}</span>)}
                  </div>
                </details>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="section contact">
      <div class="container contact-card"><div><p class="label">05 / CONTACT</p><h2>Let's build something useful.</h2><p>For backend engineering roles, technical conversations, or interesting engineering problems.</p></div><div class="actions"><a class="btn primary" href="https://www.linkedin.com/in/aman-malviya22/" target="_blank" rel="noreferrer">Connect on LinkedIn ↗</a><a class="btn secondary" href="https://github.com/AmanMalviya22" target="_blank" rel="noreferrer">Open GitHub ↗</a></div></div>
    </section>
  </main>

  <footer class="footer"><div class="container footer-inner"><span>© 2026 Aman Malviya</span><span>Astro · TypeScript · Tailwind CSS</span><a href="#top">Back to top ↑</a></div></footer>
</Layout>
